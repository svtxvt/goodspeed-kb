# Web app configuration. `pnpm run setup` copies this file to .env.local (only
# if it does not exist yet) and fills the Supabase values from `supabase status`.

# Supabase Auth, used by the browser and the Next.js server. The publishable key
# is not a secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the Next.js server reaches the NestJS API. Server-side only: the browser
# never calls the API directly.
API_URL=http://localhost:4000
