# API configuration. `pnpm run setup` copies this file to .env (only if .env does
# not exist yet) and fills the Supabase values from `supabase status`.
# Every variable is validated at boot; a bad value stops the API with a message.

# ---------------------------------------------------------------- server
PORT=4000

# ---------------------------------------------------------------- supabase
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (or a legacy anon key). Not a secret: the caller's JWT and RLS decide
# what each request can see.
SUPABASE_PUBLISHABLE_KEY=
# Used ONLY by `pnpm reindex` (an operator task across all users; bypasses RLS).
# The running API never reads it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- AI
# true  = built-in MOCK models, no API key needed. Retrieval works (lexical
#         hashing embeddings) but answers are a template that quotes a source.
# false = the OpenAI-compatible endpoints below.
AI_MOCK=true

# Chat model: any server that implements POST /chat/completions.
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-5.4-mini

# Embedding model: configured separately (some chat providers, e.g. Groq, have
# no embeddings endpoint). AI_EMBEDDING_DIMENSIONS must equal the model's output
# size. Changing the embedding model or dimensions requires `pnpm reindex`;
# changing the chat model does not.
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# Per-request timeout and SDK retries (exponential backoff on 408/409/429/5xx).
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ---------------------------------------------------------------- retrieval
# Chunks retrieved per question, and the cosine-similarity floor below which a
# chunk counts as irrelevant. The right floor depends on the embedding model:
# empty = 0.25 for real models, 0.15 for the mock. Calibrate it on your data.
RAG_MATCH_COUNT=6
RAG_MIN_SIMILARITY=
